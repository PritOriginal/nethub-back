[Unit]
Description=Nethub REST API Server
After=network.target

[Service]
User=root
Group=root
WorkingDirectory=/root/apps/nethub-back
ExecStart=/root/apps/nethub-back/server-rest --config=./configs/config.yaml
Restart=always
RestartSec=4
StandardOutput=inherit

[Install]
WantedBy=multi-user.target
